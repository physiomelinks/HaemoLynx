#!/usr/bin/env bash
# Local guardrail (CI only runs on PRs to origin). Enable once per clone:
#   git config core.hooksPath "$PWD/scripts/git-hooks"   (run from the repo root)
# 0. If core.hooksPath names another checkout's scripts/git-hooks (it is set absolute, so
#    every worktree gets the main checkout's), re-exec the committing checkout's own pre-commit first.
# 1. Refuse a commit that adds a .md file (a rename to a new name counts) other than README.md,
#    GLOSSARY.md or CODING_STANDARDS.md: every other .md is a local note and belongs in
#    .gitignore. Not checked in a merge, which may bring in upstream's docs. A new doc meant to be
#    tracked: add its name to KEPT_DOCS below, or commit with --no-verify.
# 2. Pyflakes lint on staged Python files: undefined names and redefinitions,
#    plus unused imports in staged files under tests/ only.
# 3. Fast tests (not slow, integration or realdata). When every staged file is a Markdown doc,
#    only the local-note pointer test runs (no other test reads a repo .md file). Any other
#    staged file, deletions included, runs them all.
#    Skipped when .git/hook-stamp/fast-tests-ok matches the staged tree,
#    the interpreter and its installed packages (see _stamp.sh); a passing run
#    here, or scripts/stamp-tests.sh, writes it.
#    The tests run with no GIT_* variables: git's GIT_INDEX_FILE (and GIT_DIR in a worktree) would point a test's own git calls at this repo.
#    The test run is quiet: output goes to .git/hook-stamp/fast-tests.log.
#    Bypass in an emergency with `git commit --no-verify`.
set -euo pipefail
self=$(realpath "$0")
cd "$(git rev-parse --show-toplevel)"
# core.hooksPath is absolute (Claude Code's worktree setup leaves an absolute path alone), so git runs the main
# checkout's copy from every worktree. Run the committing checkout's own copy instead, so a
# branch's pre-commit and _stamp.sh are always checked together.
own="$PWD/scripts/git-hooks/pre-commit"
if [ ! -f "$own" ]; then
    echo "pre-commit: $PWD has no scripts/git-hooks/pre-commit, so no hook ran." >&2
    exit 0
fi
if [ "$(realpath "$own")" != "$self" ]; then
    exec "$own" "$@"
fi
PY=venv/bin/python
[ -x "$PY" ] || PY=python3
. scripts/git-hooks/_stamp.sh

KEPT_DOCS=" README.md GLOSSARY.md CODING_STANDARDS.md "
if [ ! -e "$(git rev-parse --git-path MERGE_HEAD)" ]; then
    mapfile -t new_md < <(git diff --cached --name-only --diff-filter=ACR -- '*.md')
    notes=()
    for f in "${new_md[@]}"; do
        case "$KEPT_DOCS" in
            *" ${f##*/} "*) ;;
            *) notes+=("$f") ;;
        esac
    done
    if [ "${#notes[@]}" -gt 0 ]; then
        echo "pre-commit: new .md files staged: ${notes[*]}" >&2
        echo "  Only README.md, GLOSSARY.md and CODING_STANDARDS.md are tracked; every other .md is" >&2
        echo "  a local note. Add its name to .gitignore and unstage it with git rm --cached." >&2
        echo "  A new doc meant to be tracked: add it to KEPT_DOCS in this hook, or commit with --no-verify." >&2
        exit 1
    fi
fi

# examples/OLD is an archive and has known undefined names.
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM -- '*.py' ':!examples/OLD')

if [ "${#files[@]}" -gt 0 ]; then
    # pyflakes also reports style classes (unused imports, star imports, ...).
    # Keep an allowlist, so old warnings in src/ and examples/ don't block
    # commits: undefined names, redefinitions, and unused imports under tests/.
    out=$("$PY" -m pyflakes "${files[@]}" 2>&1 \
        | grep -E "undefined name '|redefinition of unused|^tests/.*imported but unused" || true)
    if [ -n "$out" ]; then
        echo "pre-commit: pyflakes findings in staged files:" >&2
        echo "$out" >&2
        exit 1
    fi
fi

# Every staged path, any status: a deleted .py must still trigger the tests.
mapfile -t staged < <(git diff --cached --name-only)
only_docs=0
if [ "${#staged[@]}" -gt 0 ]; then
    only_docs=1
    for f in "${staged[@]}"; do
        case "$f" in
            *.md) ;;
            *) only_docs=0; break ;;
        esac
    done
fi
guard=tests/test_tracked_files_name_no_local_note.py
if [ "$only_docs" -eq 1 ] && [ ! -f "$guard" ]; then
    echo "pre-commit: only .md files staged, and this checkout has no $guard, so no tests ran." >&2
    exit 0
fi

if stamp_matches; then
    echo "pre-commit: tests already passed for this exact staged tree, skipping fast tests." >&2
    exit 0
fi

if [ "$only_docs" -eq 1 ]; then
    echo "pre-commit: only .md files staged, running only $guard." >&2
    tests=("$guard")
    what="the pointer test"
else
    tests=(-m "not slow and not integration and not realdata")
    what="fast tests"
fi

# Quiet run: the full output goes to a log, the terminal gets the summary line,
# or on failure the log's last 40 lines and the log path.
log_dir=$(git rev-parse --git-path hook-stamp)
mkdir -p "$log_dir"
log="$log_dir/fast-tests.log"
rc=0
# git's GIT_INDEX_FILE (and GIT_DIR in a worktree) would send a test's own `git init` or `git add` into this repo.
unset_git=()
while IFS= read -r name; do unset_git+=(-u "$name"); done < <(compgen -e | grep '^GIT_' || true)
env "${unset_git[@]}" MPLBACKEND=Agg PYVISTA_OFF_SCREEN=true "$PY" -m pytest -q "${tests[@]}" >"$log" 2>&1 || rc=$?
if [ "$rc" -eq 0 ]; then
    tail -n 1 "$log" >&2
    # The stamp says the fast tests passed, which the pointer test alone does not show.
    [ "$only_docs" -eq 1 ] || stamp_write
else
    tail -n 40 "$log" >&2
    echo "pre-commit: $what failed, full output in $log" >&2
    exit "$rc"
fi
