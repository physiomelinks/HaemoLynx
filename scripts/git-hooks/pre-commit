#!/usr/bin/env bash
# Local guardrail (CI only runs on PRs to origin). Enable once per clone:
#   git config core.hooksPath scripts/git-hooks
# 1. Pyflakes lint on staged Python files: undefined names and redefinitions,
#    plus unused imports in staged files under tests/ only.
# 2. Fast tests (not slow, integration or realdata), skipped when every staged file is a Markdown doc (no test reads
#    a repo .md file). Any other staged file, deletions included, runs them.
#    Also skipped when .git/hook-stamp/fast-tests-ok matches the staged tree,
#    the interpreter and its installed packages (see _stamp.sh); a passing run
#    here, or scripts/stamp-tests.sh, writes it.
#    The test run is quiet: output goes to .git/hook-stamp/fast-tests.log.
#    Bypass in an emergency with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=venv/bin/python
[ -x "$PY" ] || PY=python3
. scripts/git-hooks/_stamp.sh

# examples/OLD is an archive and has known undefined names.
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACM -- '*.py' ':!examples/OLD')

if [ "${#files[@]}" -gt 0 ]; then
    # pyflakes also reports style classes (unused imports, star imports, ...).
    # Keep an allowlist, so old warnings in src/ and examples/ don't block
    # commits: undefined names, redefinitions, and unused imports under tests/.
    out=$("$PY" -m pyflakes "${files[@]}" 2>&1 \
        | grep -E "undefined name '|redefinition of unused|^tests/.*imported but unused" || true)
    if [ -n "$out" ]; then
        echo "pre-commit: pyflakes findings in staged files:" >&2
        echo "$out" >&2
        exit 1
    fi
fi

# Every staged path, any status: a deleted .py must still trigger the tests.
mapfile -t staged < <(git diff --cached --name-only)
only_docs=0
if [ "${#staged[@]}" -gt 0 ]; then
    only_docs=1
    for f in "${staged[@]}"; do
        case "$f" in
            *.md) ;;
            *) only_docs=0; break ;;
        esac
    done
fi
if [ "$only_docs" -eq 1 ]; then
    echo "pre-commit: only .md files staged, skipping fast tests." >&2
    exit 0
fi

if stamp_matches; then
    echo "pre-commit: tests already passed for this exact staged tree, skipping fast tests." >&2
    exit 0
fi

# Quiet run: the full output goes to a log, the terminal gets the summary line,
# or on failure the log's last 40 lines and the log path.
log_dir=$(git rev-parse --git-path hook-stamp)
mkdir -p "$log_dir"
log="$log_dir/fast-tests.log"
rc=0
MPLBACKEND=Agg PYVISTA_OFF_SCREEN=true "$PY" -m pytest -q -m "not slow and not integration and not realdata" >"$log" 2>&1 || rc=$?
if [ "$rc" -eq 0 ]; then
    tail -n 1 "$log" >&2
    stamp_write
else
    tail -n 40 "$log" >&2
    echo "pre-commit: fast tests failed, full output in $log" >&2
    exit "$rc"
fi
