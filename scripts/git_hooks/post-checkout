#!/bin/sh
# HaemoLynx: local-only files
#
# Brings back the local-only files -- PLAN_*.md and the run configs (*.yaml,
# *.yml) at the repository root, git-ignored since ce7c005c -- that a
# checkout, a rebase or a pull deleted because the commit before still
# tracked them. Each is written back as that commit held it, never over a
# file already there. post-merge runs this for a merging pull.
#
# Installed by scripts/install_git_hooks.py. For a pull made before it was:
#     git hook run post-checkout -- <commit before the pull> HEAD 1

old=$1
new=$2
[ "$3" = 1 ] || exit 0      # a file checkout, not a move of HEAD
case $old in
    *[!0]*) ;;
    *) exit 0 ;;            # a clone or a new worktree: nothing came before
esac
cd "$(git rev-parse --show-toplevel)" || exit 0

git diff --name-only --no-renames --diff-filter=D "$old" "$new" -- \
    ':(top,glob)PLAN_*.md' ':(top,glob)*.yaml' ':(top,glob)*.yml' |
while IFS= read -r path; do
    [ -e "$path" ] && continue
    if git cat-file --filters "$old:$path" > "$path.part"; then
        mv "$path.part" "$path" && echo "Brought back local-only $path"
    else
        rm -f "$path.part"
    fi
done
exit 0
